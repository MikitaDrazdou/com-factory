# OpenRouter key: used for Jev decisions (typesafe/jev-1.13) and for drafting comments.
OPENROUTER_API_KEY=
# Panel bind address and port (keep 127.0.0.1 unless you know what you do).
PANEL_HOST=127.0.0.1
PANEL_PORT=4777
# Path to the Aside CLI (installed by https://releases.aside.com/install.sh).
ASIDE_BIN=aside
# Timezone for schedules and "active hours".
TZ=Europe/Moscow
